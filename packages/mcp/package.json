{
  "name": "closeloop-mcp",
  "version": "0.2.1",
  "description": "MCP server for month-end reconciliation of Razorpay-style gateway settlements against the bank statement and the ledger. Deterministic matching (exact, fuzzy UTR, batch decomposition) with a constrained AI layer.",
  "type": "module",
  "license": "MIT",
  "author": "Himanshu Gupta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmshuv/closeloop.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/hmshuv/closeloop#readme",
  "bugs": {
    "url": "https://github.com/hmshuv/closeloop/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "reconciliation",
    "fintech",
    "razorpay",
    "india",
    "gst",
    "claude"
  ],
  "bin": {
    "closeloop-mcp": "dist/closeloop-mcp.js"
  },
  "files": [
    "dist",
    "config",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node bin/dev.js",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@closeloop/core": "workspace:*",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15"
  }
}
