{
  "name": "closeloop-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter dashboard typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen": "tsx scripts/gen.ts",
    "recon": "tsx scripts/recon.ts",
    "demo:cases": "tsx scripts/demo-cases.ts",
    "eval": "tsx scripts/eval.ts",
    "build": "pnpm --filter closeloop-mcp build",
    "mcp:dev": "node packages/mcp/bin/dev.js",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "snapshot": "tsx scripts/snapshot.ts",
    "fixtures": "tsx packages/mcp/src/bin.ts demo-report fixtures/razorpay/recon-combined.synthetic.json && tsx packages/mcp/src/bin.ts demo-report fixtures/razorpay/recon-combined.synthetic.csv",
    "dashboard:dev": "pnpm --filter dashboard dev",
    "dashboard:build": "pnpm --filter dashboard build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@closeloop/core": "workspace:*",
    "closeloop-mcp": "workspace:*",
    "zod": "^3.25.76"
  }
}
