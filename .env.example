# Optional. CloseLoop works fully without an LLM (deterministic fallback).
# Any OpenAI-compatible chat completions endpoint works (Groq, Google AI Studio, OpenRouter, Ollama).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional, for reasoning models (e.g. openai/gpt-oss-120b on Groq): low | medium | high
LLM_REASONING_EFFORT=
# Optional database location (defaults to ~/.closeloop/closeloop.db)
CLOSELOOP_DB=
